          "name": "post_price",
          "value": "(\"post\".\"price_kind\" = 'amount' and coalesce(\"post\".\"price_amount\", 0) between 1 and 1000000)\n        or (\"post\".\"price_kind\" in ('free', 'negotiable') and \"post\".\"price_amount\" is null)"
        },
        "post_exchange_any": {
          "name": "post_exchange_any",
          "value": "\"post\".\"exchange_meetup\" or \"post\".\"exchange_delivery\""
        },
        "post_meetup_location": {
          "name": "post_meetup_location",
          "value": "case when \"post\".\"exchange_meetup\"\n        then char_length(btrim(coalesce(\"post\".\"meetup_location\", ''))) between 1 and 120\n        else \"post\".\"meetup_location\" is null end"
        },
        "post_delivery_area": {
          "name": "post_delivery_area",
          "value": "case when \"post\".\"exchange_delivery\"\n        then char_length(btrim(coalesce(\"post\".\"delivery_area\", ''))) between 1 and 120\n        else \"post\".\"delivery_area\" is null end"
        },
        "post_open_expiry": {
          "name": "post_open_expiry",
          "value": "\"post\".\"status\" <> 'open' or \"post\".\"expires_at\" > \"post\".\"listed_at\""
        }
